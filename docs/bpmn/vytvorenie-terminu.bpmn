  <bpmn:process id="Process_CancelBooking" name="Zrušenie rezervácie — rozhranie stylistu" isExecutable="false">
    <bpmn:documentation>Stylista a admin používajú rovnaké rozhranie a rovnakú implementáciu. Tento pool zobrazuje použitie stylistom, druhý pool adminom. Vetva podľa role pri načítaní zoznamu aj pri zrušení vychádza z identity prihláseného používateľa overenej CRM. Admin vidí a ruší všetky rezervácie, stylista iba vlastné. V tomto poole sa pri zobrazení uplatní vetva stylistu. Dokončené a už zrušené rezervácie sa nerušia. Dôvod je voliteľný. Platba a storno poplatky sú mimo rozsahu. Zrušenie zachová históriu, nejde o fyzické vymazanie.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_CancelBooking">
      <bpmn:lane id="Lane_CancelStylist" name="Stylista — len vlastné rezervácie">
        <bpmn:flowNodeRef>Start_CancelStylist</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SelectOwnBooking</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_StylistCancelReason</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_StylistConfirmCancel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CancelCRM" name="CRM / rezervačný systém">
        <bpmn:flowNodeRef>Task_CheckDisplayRole</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_DisplayAdmin</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_DisplayAllBookings</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_DisplayOwnBookings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckCancelAccess</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_CancelAccess</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_DenyCancelAccess</bpmn:flowNodeRef><bpmn:flowNodeRef>End_CancelDenied</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CheckCancelState</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_CancelState</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_DenyCancelState</bpmn:flowNodeRef><bpmn:flowNodeRef>End_CancelUnavailable</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CancelBooking</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_FreeCancelledSlot</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RecordCancellation</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CancelEmail</bpmn:flowNodeRef><bpmn:flowNodeRef>End_CancelBooking</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_CancelStylist" name="Otvorenie rozhrania rezervácií"><bpmn:outgoing>Flow_CheckDisplayRole</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_CheckDisplayRole" name="Overenie role pri načítaní zoznamu"><bpmn:incoming>Flow_CheckDisplayRole</bpmn:incoming><bpmn:outgoing>Flow_DisplayRoleDecision</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_DisplayAdmin" name="Je používateľ admin?"><bpmn:incoming>Flow_DisplayRoleDecision</bpmn:incoming><bpmn:outgoing>Flow_DisplayAllBookings</bpmn:outgoing><bpmn:outgoing>Flow_DisplayOwnBookings</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_DisplayAllBookings" name="Zobrazenie všetkých rezervácií"><bpmn:incoming>Flow_DisplayAllBookings</bpmn:incoming><bpmn:outgoing>Flow_SelectFromAll</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_DisplayOwnBookings" name="Zobrazenie iba vlastných rezervácií"><bpmn:incoming>Flow_DisplayOwnBookings</bpmn:incoming><bpmn:outgoing>Flow_SelectOwnBooking</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_SelectOwnBooking" name="Výber rezervácie zo zoznamu"><bpmn:incoming>Flow_SelectOwnBooking</bpmn:incoming><bpmn:incoming>Flow_SelectFromAll</bpmn:incoming><bpmn:outgoing>Flow_StylistCancelReason</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_StylistCancelReason" name="Zadanie voliteľného dôvodu zrušenia"><bpmn:incoming>Flow_StylistCancelReason</bpmn:incoming><bpmn:outgoing>Flow_StylistConfirmCancel</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_StylistConfirmCancel" name="Potvrdenie požiadavky na zrušenie"><bpmn:incoming>Flow_StylistConfirmCancel</bpmn:incoming><bpmn:outgoing>Flow_StylistCancelAccess</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_CheckCancelAccess" name="Overenie role a vlastníctva rezervácie">
      <bpmn:documentation>CRM povolí admina pri každej rezervácii. Stylistu povolí iba vtedy, keď identita prihláseného stylistu zodpovedá stylistovi priradenému k rezervácii. Ostatné prípady odmietne.</bpmn:documentation>
      <bpmn:incoming>Flow_StylistCancelAccess</bpmn:incoming><bpmn:outgoing>Flow_CancelAccessDecision</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_CancelAccess" name="Je admin alebo vlastník rezervácie?"><bpmn:incoming>Flow_CancelAccessDecision</bpmn:incoming><bpmn:outgoing>Flow_CancelAccessAllowed</bpmn:outgoing><bpmn:outgoing>Flow_CancelAccessDenied</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_DenyCancelAccess" name="Zobrazenie odmietnutia pre chýbajúce oprávnenie"><bpmn:incoming>Flow_CancelAccessDenied</bpmn:incoming><bpmn:outgoing>Flow_CancelDeniedEnd</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_CancelDenied" name="Zrušenie nepovolené"><bpmn:incoming>Flow_CancelDeniedEnd</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_CheckCancelState" name="Kontrola aktuálneho stavu rezervácie"><bpmn:incoming>Flow_CancelAccessAllowed</bpmn:incoming><bpmn:outgoing>Flow_CancelStateDecision</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_CancelState" name="Možno rezerváciu zrušiť?"><bpmn:incoming>Flow_CancelStateDecision</bpmn:incoming><bpmn:outgoing>Flow_CancelStateAllowed</bpmn:outgoing><bpmn:outgoing>Flow_CancelStateDenied</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_DenyCancelState" name="Zobrazenie dôvodu, prečo nemožno zrušiť">
      <bpmn:documentation>Rezervácia je napríklad už dokončená alebo zrušená. Bez zmeny stavu a bez ďalšieho oznámenia zákazníkovi.</bpmn:documentation>
      <bpmn:incoming>Flow_CancelStateDenied</bpmn:incoming><bpmn:outgoing>Flow_CancelUnavailableEnd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_CancelUnavailable" name="Rezervácia sa nezmenila"><bpmn:incoming>Flow_CancelUnavailableEnd</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_CancelBooking" name="Označenie rezervácie ako zrušenej">
      <bpmn:documentation>Pri zmene CRM opätovne zohľadní aktuálne oprávnenie a stav, aby súbežná zmena neviedla k neoprávnenému alebo opakovanému zrušeniu.</bpmn:documentation>
      <bpmn:incoming>Flow_CancelStateAllowed</bpmn:incoming><bpmn:outgoing>Flow_FreeCancelledSlot</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_FreeCancelledSlot" name="Uvoľnenie termínu v kalendári"><bpmn:incoming>Flow_FreeCancelledSlot</bpmn:incoming><bpmn:outgoing>Flow_RecordCancellation</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_RecordCancellation" name="Zápis autora, času a dôvodu zrušenia"><bpmn:incoming>Flow_RecordCancellation</bpmn:incoming><bpmn:outgoing>Flow_CancelEmail</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_CancelEmail" name="Odoslanie e-mailu zákazníkovi o zrušení"><bpmn:incoming>Flow_CancelEmail</bpmn:incoming><bpmn:outgoing>Flow_CancelBookingEnd</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_CancelBooking" name="Rezervácia zrušená"><bpmn:incoming>Flow_CancelBookingEnd</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_CheckDisplayRole" sourceRef="Start_CancelStylist" targetRef="Task_CheckDisplayRole" />
    <bpmn:sequenceFlow id="Flow_DisplayRoleDecision" sourceRef="Task_CheckDisplayRole" targetRef="Gateway_DisplayAdmin" />
    <bpmn:sequenceFlow id="Flow_DisplayAllBookings" name="Áno — admin" sourceRef="Gateway_DisplayAdmin" targetRef="Task_DisplayAllBookings" />
    <bpmn:sequenceFlow id="Flow_DisplayOwnBookings" name="Nie — stylista" sourceRef="Gateway_DisplayAdmin" targetRef="Task_DisplayOwnBookings" />
    <bpmn:sequenceFlow id="Flow_SelectFromAll" sourceRef="Task_DisplayAllBookings" targetRef="Task_SelectOwnBooking" />
    <bpmn:sequenceFlow id="Flow_SelectOwnBooking" sourceRef="Task_DisplayOwnBookings" targetRef="Task_SelectOwnBooking" />
    <bpmn:sequenceFlow id="Flow_StylistCancelReason" sourceRef="Task_SelectOwnBooking" targetRef="Task_StylistCancelReason" />
    <bpmn:sequenceFlow id="Flow_StylistConfirmCancel" sourceRef="Task_StylistCancelReason" targetRef="Task_StylistConfirmCancel" />
    <bpmn:sequenceFlow id="Flow_StylistCancelAccess" sourceRef="Task_StylistConfirmCancel" targetRef="Task_CheckCancelAccess" />
    <bpmn:sequenceFlow id="Flow_CancelAccessDecision" sourceRef="Task_CheckCancelAccess" targetRef="Gateway_CancelAccess" />
    <bpmn:sequenceFlow id="Flow_CancelAccessAllowed" name="Áno" sourceRef="Gateway_CancelAccess" targetRef="Task_CheckCancelState" />
    <bpmn:sequenceFlow id="Flow_CancelAccessDenied" name="Nie" sourceRef="Gateway_CancelAccess" targetRef="Task_DenyCancelAccess" />
    <bpmn:sequenceFlow id="Flow_CancelDeniedEnd" sourceRef="Task_DenyCancelAccess" targetRef="End_CancelDenied" />
    <bpmn:sequenceFlow id="Flow_CancelStateDecision" sourceRef="Task_CheckCancelState" targetRef="Gateway_CancelState" />
    <bpmn:sequenceFlow id="Flow_CancelStateAllowed" name="Áno" sourceRef="Gateway_CancelState" targetRef="Task_CancelBooking" />
    <bpmn:sequenceFlow id="Flow_CancelStateDenied" name="Nie" sourceRef="Gateway_CancelState" targetRef="Task_DenyCancelState" />
    <bpmn:sequenceFlow id="Flow_CancelUnavailableEnd" sourceRef="Task_DenyCancelState" targetRef="End_CancelUnavailable" />
    <bpmn:sequenceFlow id="Flow_FreeCancelledSlot" sourceRef="Task_CancelBooking" targetRef="Task_FreeCancelledSlot" />
    <bpmn:sequenceFlow id="Flow_RecordCancellation" sourceRef="Task_FreeCancelledSlot" targetRef="Task_RecordCancellation" />
    <bpmn:sequenceFlow id="Flow_CancelEmail" sourceRef="Task_RecordCancellation" targetRef="Task_CancelEmail" />
    <bpmn:sequenceFlow id="Flow_CancelBookingEnd" sourceRef="Task_CancelEmail" targetRef="End_CancelBooking" />
  </bpmn:process>
  <bpmn:process id="Process_CancelAdmin" name="Zrušenie rezervácie — rozhranie admina" isExecutable="false">
    <bpmn:documentation>Rovnaké rozhranie a implementácia ako v poole stylistu, ale prihlásený používateľ je admin. Pri zobrazení zoznamu sa preto uplatní vetva všetkých rezervácií. Oprávnenie sa znova overí pri zrušení na strane CRM. Stavové obmedzenia sú rovnaké pre obe roly. Dôvod je voliteľný. Zrušenie zachová históriu, nejde o fyzické vymazanie.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_AdminCancellation">
      <bpmn:lane id="Lane_CancelAdmin" name="Admin — rovnaké rozhranie">
        <bpmn:flowNodeRef>Start_CancelAdmin</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SelectAnyBooking</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AdminCancelReason</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AdminConfirmCancel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AdminCancelCRM" name="CRM / rezervačný systém">
        <bpmn:flowNodeRef>Task_AdminCheckDisplayRole</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_AdminDisplayRole</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AdminDisplayAllBookings</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AdminDisplayOwnBookings</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AdminCheckCancelAccess</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_AdminCancelAccess</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AdminDenyCancelAccess</bpmn:flowNodeRef><bpmn:flowNodeRef>End_AdminCancelDenied</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AdminCheckCancelState</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_AdminCancelState</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AdminDenyCancelState</bpmn:flowNodeRef><bpmn:flowNodeRef>End_AdminCancelUnavailable</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AdminCancelBooking</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AdminFreeCancelledSlot</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AdminRecordCancellation</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AdminCancelEmail</bpmn:flowNodeRef><bpmn:flowNodeRef>End_AdminCancelBooking</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_CancelAdmin" name="Otvorenie rozhrania rezervácií"><bpmn:outgoing>Flow_AdminCheckDisplayRole</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_AdminCheckDisplayRole" name="Overenie role pri načítaní zoznamu"><bpmn:incoming>Flow_AdminCheckDisplayRole</bpmn:incoming><bpmn:outgoing>Flow_AdminDisplayRoleDecision</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_AdminDisplayRole" name="Je používateľ admin?"><bpmn:incoming>Flow_AdminDisplayRoleDecision</bpmn:incoming><bpmn:outgoing>Flow_AdminDisplayAllBookings</bpmn:outgoing><bpmn:outgoing>Flow_AdminDisplayOwnBookings</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_AdminDisplayAllBookings" name="Zobrazenie všetkých rezervácií"><bpmn:incoming>Flow_AdminDisplayAllBookings</bpmn:incoming><bpmn:outgoing>Flow_AdminSelectFromAll</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_AdminDisplayOwnBookings" name="Zobrazenie iba vlastných rezervácií"><bpmn:incoming>Flow_AdminDisplayOwnBookings</bpmn:incoming><bpmn:outgoing>Flow_SelectAnyBooking</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_SelectAnyBooking" name="Výber rezervácie zo zoznamu"><bpmn:incoming>Flow_SelectAnyBooking</bpmn:incoming><bpmn:incoming>Flow_AdminSelectFromAll</bpmn:incoming><bpmn:outgoing>Flow_AdminCancelReason</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_AdminCancelReason" name="Zadanie voliteľného dôvodu zrušenia"><bpmn:incoming>Flow_AdminCancelReason</bpmn:incoming><bpmn:outgoing>Flow_AdminConfirmCancel</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_AdminConfirmCancel" name="Potvrdenie požiadavky na zrušenie"><bpmn:incoming>Flow_AdminConfirmCancel</bpmn:incoming><bpmn:outgoing>Flow_AdminCancelAccess</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_AdminCheckCancelAccess" name="Overenie role a vlastníctva rezervácie">
      <bpmn:documentation>CRM použije rovnakú podmienku ako v rozhraní stylistu: prihlásený admin alebo prihlásený stylista priradený k rezervácii. Admin nemusí byť vlastníkom rezervácie. Role ani identita sa nepreberajú z neoverených údajov formulára.</bpmn:documentation>
      <bpmn:incoming>Flow_AdminCancelAccess</bpmn:incoming><bpmn:outgoing>Flow_AdminCancelAccessDecision</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_AdminCancelAccess" name="Je admin alebo vlastník rezervácie?"><bpmn:incoming>Flow_AdminCancelAccessDecision</bpmn:incoming><bpmn:outgoing>Flow_AdminCancelAccessAllowed</bpmn:outgoing><bpmn:outgoing>Flow_AdminCancelAccessDenied</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_AdminDenyCancelAccess" name="Zobrazenie odmietnutia pre chýbajúce oprávnenie"><bpmn:incoming>Flow_AdminCancelAccessDenied</bpmn:incoming><bpmn:outgoing>Flow_AdminCancelDeniedEnd</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_AdminCancelDenied" name="Zrušenie nepovolené"><bpmn:incoming>Flow_AdminCancelDeniedEnd</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_AdminCheckCancelState" name="Kontrola aktuálneho stavu rezervácie"><bpmn:incoming>Flow_AdminCancelAccessAllowed</bpmn:incoming><bpmn:outgoing>Flow_AdminCancelStateDecision</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_AdminCancelState" name="Možno rezerváciu zrušiť?"><bpmn:incoming>Flow_AdminCancelStateDecision</bpmn:incoming><bpmn:outgoing>Flow_AdminCancelStateAllowed</bpmn:outgoing><bpmn:outgoing>Flow_AdminCancelStateDenied</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_AdminDenyCancelState" name="Zobrazenie dôvodu, prečo nemožno zrušiť">
      <bpmn:documentation>Dokončená alebo už zrušená rezervácia sa nezmení a zákazníkovi sa neposiela ďalší e-mail.</bpmn:documentation>
      <bpmn:incoming>Flow_AdminCancelStateDenied</bpmn:incoming><bpmn:outgoing>Flow_AdminCancelUnavailableEnd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_AdminCancelUnavailable" name="Rezervácia sa nezmenila"><bpmn:incoming>Flow_AdminCancelUnavailableEnd</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_AdminCancelBooking" name="Označenie rezervácie ako zrušenej">
      <bpmn:documentation>Pri zmene CRM opätovne zohľadní aktuálne oprávnenie a stav, aby súbežná zmena neviedla k neoprávnenému alebo opakovanému zrušeniu.</bpmn:documentation>
      <bpmn:incoming>Flow_AdminCancelStateAllowed</bpmn:incoming><bpmn:outgoing>Flow_AdminFreeCancelledSlot</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AdminFreeCancelledSlot" name="Uvoľnenie termínu v kalendári"><bpmn:incoming>Flow_AdminFreeCancelledSlot</bpmn:incoming><bpmn:outgoing>Flow_AdminRecordCancellation</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_AdminRecordCancellation" name="Zápis autora, času a dôvodu zrušenia"><bpmn:incoming>Flow_AdminRecordCancellation</bpmn:incoming><bpmn:outgoing>Flow_AdminCancelEmail</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_AdminCancelEmail" name="Odoslanie e-mailu zákazníkovi o zrušení"><bpmn:incoming>Flow_AdminCancelEmail</bpmn:incoming><bpmn:outgoing>Flow_AdminCancelBookingEnd</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_AdminCancelBooking" name="Rezervácia zrušená"><bpmn:incoming>Flow_AdminCancelBookingEnd</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_AdminCheckDisplayRole" sourceRef="Start_CancelAdmin" targetRef="Task_AdminCheckDisplayRole" />
    <bpmn:sequenceFlow id="Flow_AdminDisplayRoleDecision" sourceRef="Task_AdminCheckDisplayRole" targetRef="Gateway_AdminDisplayRole" />
