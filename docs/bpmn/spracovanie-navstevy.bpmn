<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Visit" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:dataStore id="DataStore_Analytics" name="Analytická DB" />
  <bpmn:dataStore id="DataStore_Reviews" name="Recenzie v CRM" />
  <bpmn:collaboration id="Collaboration_Visit">
    <bpmn:participant id="Participant_Salon" name="Salón — spracovanie návštevy" processRef="Process_Visit" />
    <bpmn:participant id="Participant_Analytics" name="Analytická aplikácia" processRef="Process_Analytics" />
    <bpmn:messageFlow id="MessageFlow_VisitAnalytics" name="Údaje návštevy" sourceRef="Task_ExportVisit" targetRef="Start_Analytics" />
    <bpmn:messageFlow id="MessageFlow_ReviewAnalytics" name="Recenzia návštevy" sourceRef="Task_ExportReview" targetRef="Start_ReviewAnalytics" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Visit" name="Spracovanie návštevy zákazníka s rezerváciou" isExecutable="false">
    <bpmn:documentation>Proces zahŕňa iba existujúce rezervácie a dokončené služby. Nepríchod, walk-in, čiastočne vykonané alebo nevykonané služby a platba sú mimo rozsahu. Používateľ je prihlásený. Stylista spracúva iba vlastné rezervácie, admin všetky. Službu vykonáva priradený stylista. Zákazník je rolou spoločného procesu v prvej lane. Po uzavretí návštevy môže zákazník recenziu odoslať neskôr alebo vôbec; čakanie nebráni obsluhe ďalších návštev.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Visit">
      <bpmn:lane id="Lane_Customer" name="Zákazník">
        <bpmn:flowNodeRef>Task_OpenReviewForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FillReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveReviewFeedback</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_User" name="Stylista / admin">
        <bpmn:flowNodeRef>Start_Visit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectBooking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordArrival</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PerformService</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateService</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CRM" name="CRM / rezervačný systém">
        <bpmn:flowNodeRef>Task_CheckAccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Access</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DenyAccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Denied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SaveArrival</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateEvaluation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CloseVisit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExportVisit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendReviewEmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReviewBranches</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_CollectReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReviewValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendReviewErrors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SaveReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExportReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Visit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_ReviewReminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckReviewStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReminderNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendReviewReminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Reminder</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Visit" name="Zákazník prišiel">
      <bpmn:outgoing>Flow_Select</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_SelectBooking" name="Výber existujúcej rezervácie">
      <bpmn:incoming>Flow_Select</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckAccess</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CheckAccess" name="Overenie oprávnenia k rezervácii">
      <bpmn:documentation>Stylista smie spracovať vlastnú rezerváciu. Admin smie spracovať ktorúkoľvek rezerváciu.</bpmn:documentation>
      <bpmn:incoming>Flow_CheckAccess</bpmn:incoming>
      <bpmn:outgoing>Flow_AccessDecision</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Access" name="Má používateľ oprávnenie?">
      <bpmn:incoming>Flow_AccessDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_AccessAllowed</bpmn:outgoing>
      <bpmn:outgoing>Flow_AccessDenied</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_DenyAccess" name="Zobrazenie odmietnutia prístupu">
      <bpmn:incoming>Flow_AccessDenied</bpmn:incoming>
      <bpmn:outgoing>Flow_DeniedEnd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Denied" name="Prístup odmietnutý">
      <bpmn:incoming>Flow_DeniedEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_RecordArrival" name="Potvrdenie príchodu a ručné zadanie času">
      <bpmn:documentation>Používateľ zadá skutočný dátum a čas príchodu zákazníka, nie čas vykonania zápisu.</bpmn:documentation>
      <bpmn:incoming>Flow_AccessAllowed</bpmn:incoming>
      <bpmn:outgoing>Flow_SaveArrival</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SaveArrival" name="Uloženie príchodu a výpočet meškania">
      <bpmn:documentation>CRM vypočíta meškanie v minútach ako max(0, skutočný príchod − plánovaný začiatok). Skorší príchod má meškanie 0. Meškanie nemení ďalší priebeh procesu.</bpmn:documentation>
      <bpmn:incoming>Flow_SaveArrival</bpmn:incoming>
      <bpmn:outgoing>Flow_PerformService</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PerformService" name="Vykonanie služby priradeným stylistom">
      <bpmn:incoming>Flow_PerformService</bpmn:incoming>
      <bpmn:outgoing>Flow_EvaluateService</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_EvaluateService" name="Zápis vyhodnotenia dokončenej služby">
      <bpmn:documentation>Povinné údaje: výsledok „Dokončená“, skutočné trvanie ručne v minútach a konečná cena. Poznámka stylistu je voliteľná. Spokojnosť zadáva zákazník v následnej recenzii, nie stylista. Pri oprave používateľ opraví údaje podľa chýb validácie.</bpmn:documentation>
      <bpmn:incoming>Flow_EvaluateService</bpmn:incoming>
      <bpmn:incoming>Flow_CorrectEvaluation</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidateEvaluation</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ValidateEvaluation" name="Kontrola vyhodnotenia služby">
      <bpmn:documentation>Kontrola povinných údajov, kladného trvania a nezápornej ceny. Pri chybe CRM zobrazí informácie na opravu. Spokojnosť sa kontroluje samostatne pri recenzii.</bpmn:documentation>
      <bpmn:incoming>Flow_ValidateEvaluation</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidationDecision</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Valid" name="Sú údaje platné?">
      <bpmn:incoming>Flow_ValidationDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidEvaluation</bpmn:outgoing>
      <bpmn:outgoing>Flow_CorrectEvaluation</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CloseVisit" name="Uloženie vyhodnotenia a uzavretie návštevy">
      <bpmn:documentation>CRM uloží vyhodnotenie a označí rezerváciu ako dokončenú. Uzavretie neznamená evidenciu úhrady.</bpmn:documentation>
      <bpmn:incoming>Flow_ValidEvaluation</bpmn:incoming>
      <bpmn:outgoing>Flow_ExportVisit</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ExportVisit" name="Odoslanie údajov návštevy do analytickej aplikácie">
      <bpmn:documentation>Diagram nešpecifikuje spôsob prenosu ani spracovanie zlyhania prenosu.</bpmn:documentation>
      <bpmn:incoming>Flow_ExportVisit</bpmn:incoming>
      <bpmn:outgoing>Flow_SendReviewEmail</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SendReviewEmail" name="Odoslanie e-mailu s formulárom na recenziu">
      <bpmn:incoming>Flow_SendReviewEmail</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewBranches</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_ReviewBranches">
      <bpmn:incoming>Flow_ReviewBranches</bpmn:incoming>
      <bpmn:outgoing>Flow_OpenReviewForm</bpmn:outgoing>
      <bpmn:outgoing>Flow_WaitReminder</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_OpenReviewForm" name="Otvorenie formulára z e-mailu">
      <bpmn:incoming>Flow_OpenReviewForm</bpmn:incoming>
      <bpmn:outgoing>Flow_FillReview</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_FillReview" name="Zadanie hodnotenia 1–5 a voliteľného komentára">
      <bpmn:documentation>Hodnotenie 1–5 je povinné, komentár voliteľný. Zákazník môže formulár vyplniť neskôr alebo vôbec. Jedna pripomienka po 24 hodinách iba zopakuje odkaz na rovnaký formulár.</bpmn:documentation>
      <bpmn:incoming>Flow_FillReview</bpmn:incoming>
      <bpmn:incoming>Flow_ReviewRetry</bpmn:incoming>
      <bpmn:outgoing>Flow_SubmitReview</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SubmitReview" name="Odoslanie recenzie cez formulár">
      <bpmn:incoming>Flow_SubmitReview</bpmn:incoming>
      <bpmn:outgoing>Flow_CollectReview</bpmn:outgoing>
    </bpmn:task>
    <bpmn:subProcess id="SubProcess_CollectReview" name="Kontrola recenzie">
      <bpmn:incoming>Flow_CollectReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewDecision</bpmn:outgoing>
      <bpmn:startEvent id="Start_CollectReview">
        <bpmn:outgoing>Flow_ValidateReview</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Task_ValidateReview" name="Kontrola hodnotenia a väzby na návštevu">
        <bpmn:documentation>Kontrola povinného celočíselného hodnotenia od 1 do 5 a väzby na dokončenú návštevu. Komentár je voliteľný. Výsledok kontroly je vstupom do následnej rozhodovacej brány.</bpmn:documentation>
        <bpmn:incoming>Flow_ValidateReview</bpmn:incoming>
        <bpmn:outgoing>Flow_CollectedReview</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="End_CollectReview">
        <bpmn:incoming>Flow_CollectedReview</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_ValidateReview" sourceRef="Start_CollectReview" targetRef="Task_ValidateReview" />
      <bpmn:sequenceFlow id="Flow_CollectedReview" sourceRef="Task_ValidateReview" targetRef="End_CollectReview" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Gateway_ReviewValid" name="Je recenzia platná?">
      <bpmn:incoming>Flow_ReviewDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewValid</bpmn:outgoing>
      <bpmn:outgoing>Flow_ReviewInvalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_SendReviewErrors" name="Zobrazenie chýb na opravu">
      <bpmn:incoming>Flow_ReviewInvalid</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewRetry</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SaveReview" name="Uloženie platnej recenzie v CRM">
      <bpmn:incoming>Flow_ReviewValid</bpmn:incoming>
      <bpmn:outgoing>Flow_ConfirmReview</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Association_SaveReview">
        <bpmn:targetRef>DataStoreReference_Reviews</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_ConfirmReview" name="Zobrazenie potvrdenia prijatia recenzie">
      <bpmn:incoming>Flow_ConfirmReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewFeedback</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ReceiveReviewFeedback" name="Oboznámenie sa s potvrdením recenzie">
      <bpmn:incoming>Flow_ReviewFeedback</bpmn:incoming>
      <bpmn:outgoing>Flow_VisitEnd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ExportReview" name="Odoslanie recenzie do analytickej aplikácie">
      <bpmn:incoming>Flow_VisitEnd</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewExportEnd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Visit" name="Recenzia spracovaná">
      <bpmn:documentation>Ukončí túto konkrétnu návštevu vrátane prípadného čakania na pripomienku. Proces samostatnej analytickej aplikácie pokračuje nezávisle.</bpmn:documentation>
      <bpmn:incoming>Flow_ReviewExportEnd</bpmn:incoming>
      <bpmn:terminateEventDefinition id="Terminate_ReviewComplete" />
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Timer_ReviewReminder" name="24 hodín od prvého e-mailu">
      <bpmn:incoming>Flow_WaitReminder</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckReviewStatus</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_ReviewReminder">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_CheckReviewStatus" name="Kontrola prijatia platnej recenzie">
      <bpmn:documentation>Pred odoslaním pripomienky CRM overí aktuálny stav recenzie. Ak už bola platná recenzia prijatá, pripomienka sa neodošle. Kontrola stavu a rozhodnutie o odoslaní zohľadňujú súbežné prijatie recenzie.</bpmn:documentation>
      <bpmn:incoming>Flow_CheckReviewStatus</bpmn:incoming>
      <bpmn:outgoing>Flow_ReminderDecision</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ReminderNeeded" name="Chýba platná recenzia?">
      <bpmn:incoming>Flow_ReminderDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewReminder</bpmn:outgoing>
      <bpmn:outgoing>Flow_SkipReminder</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_SendReviewReminder" name="Odoslanie jednej pripomienky zákazníkovi">
      <bpmn:documentation>CRM odošle iba jednu pripomienku na zákazníkov e-mail. Ďalšie pripomienky sa neposielajú. Zákazník môže naďalej použiť pôvodný formulár, preto tu nevzniká ďalší token v jeho lane.</bpmn:documentation>
      <bpmn:incoming>Flow_ReviewReminder</bpmn:incoming>
      <bpmn:outgoing>Flow_ReminderEnd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Reminder" name="Kontrola pripomienky ukončená">
      <bpmn:incoming>Flow_ReminderEnd</bpmn:incoming>
      <bpmn:incoming>Flow_SkipReminder</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Select" sourceRef="Start_Visit" targetRef="Task_SelectBooking" />
    <bpmn:sequenceFlow id="Flow_CheckAccess" sourceRef="Task_SelectBooking" targetRef="Task_CheckAccess" />
    <bpmn:sequenceFlow id="Flow_AccessDecision" sourceRef="Task_CheckAccess" targetRef="Gateway_Access" />
    <bpmn:sequenceFlow id="Flow_AccessAllowed" name="Áno" sourceRef="Gateway_Access" targetRef="Task_RecordArrival" />
    <bpmn:sequenceFlow id="Flow_AccessDenied" name="Nie" sourceRef="Gateway_Access" targetRef="Task_DenyAccess" />
    <bpmn:sequenceFlow id="Flow_DeniedEnd" sourceRef="Task_DenyAccess" targetRef="End_Denied" />
    <bpmn:sequenceFlow id="Flow_SaveArrival" sourceRef="Task_RecordArrival" targetRef="Task_SaveArrival" />
    <bpmn:sequenceFlow id="Flow_PerformService" sourceRef="Task_SaveArrival" targetRef="Task_PerformService" />
    <bpmn:sequenceFlow id="Flow_EvaluateService" sourceRef="Task_PerformService" targetRef="Task_EvaluateService" />
    <bpmn:sequenceFlow id="Flow_ValidateEvaluation" sourceRef="Task_EvaluateService" targetRef="Task_ValidateEvaluation" />
    <bpmn:sequenceFlow id="Flow_ValidationDecision" sourceRef="Task_ValidateEvaluation" targetRef="Gateway_Valid" />
    <bpmn:sequenceFlow id="Flow_ValidEvaluation" name="Áno" sourceRef="Gateway_Valid" targetRef="Task_CloseVisit" />
    <bpmn:sequenceFlow id="Flow_CorrectEvaluation" name="Nie — opraviť údaje" sourceRef="Gateway_Valid" targetRef="Task_EvaluateService" />
    <bpmn:sequenceFlow id="Flow_ExportVisit" sourceRef="Task_CloseVisit" targetRef="Task_ExportVisit" />
    <bpmn:sequenceFlow id="Flow_SendReviewEmail" sourceRef="Task_ExportVisit" targetRef="Task_SendReviewEmail" />
    <bpmn:sequenceFlow id="Flow_ReviewBranches" sourceRef="Task_SendReviewEmail" targetRef="Gateway_ReviewBranches" />
    <bpmn:sequenceFlow id="Flow_OpenReviewForm" sourceRef="Gateway_ReviewBranches" targetRef="Task_OpenReviewForm" />
    <bpmn:sequenceFlow id="Flow_FillReview" sourceRef="Task_OpenReviewForm" targetRef="Task_FillReview" />
    <bpmn:sequenceFlow id="Flow_SubmitReview" sourceRef="Task_FillReview" targetRef="Task_SubmitReview" />
    <bpmn:sequenceFlow id="Flow_CollectReview" sourceRef="Task_SubmitReview" targetRef="SubProcess_CollectReview" />
    <bpmn:sequenceFlow id="Flow_ReviewDecision" sourceRef="SubProcess_CollectReview" targetRef="Gateway_ReviewValid" />
    <bpmn:sequenceFlow id="Flow_ReviewValid" name="Áno" sourceRef="Gateway_ReviewValid" targetRef="Task_SaveReview" />
    <bpmn:sequenceFlow id="Flow_ReviewInvalid" name="Nie" sourceRef="Gateway_ReviewValid" targetRef="Task_SendReviewErrors" />
    <bpmn:sequenceFlow id="Flow_ReviewRetry" sourceRef="Task_SendReviewErrors" targetRef="Task_FillReview" />
    <bpmn:sequenceFlow id="Flow_ConfirmReview" sourceRef="Task_SaveReview" targetRef="Task_ConfirmReview" />
    <bpmn:sequenceFlow id="Flow_ReviewFeedback" sourceRef="Task_ConfirmReview" targetRef="Task_ReceiveReviewFeedback" />
    <bpmn:sequenceFlow id="Flow_VisitEnd" sourceRef="Task_ReceiveReviewFeedback" targetRef="Task_ExportReview" />
    <bpmn:sequenceFlow id="Flow_ReviewExportEnd" sourceRef="Task_ExportReview" targetRef="End_Visit" />
    <bpmn:sequenceFlow id="Flow_WaitReminder" sourceRef="Gateway_ReviewBranches" targetRef="Timer_ReviewReminder" />
    <bpmn:sequenceFlow id="Flow_CheckReviewStatus" sourceRef="Timer_ReviewReminder" targetRef="Task_CheckReviewStatus" />
    <bpmn:sequenceFlow id="Flow_ReminderDecision" sourceRef="Task_CheckReviewStatus" targetRef="Gateway_ReminderNeeded" />
    <bpmn:sequenceFlow id="Flow_ReviewReminder" name="Áno" sourceRef="Gateway_ReminderNeeded" targetRef="Task_SendReviewReminder" />
    <bpmn:sequenceFlow id="Flow_SkipReminder" name="Nie" sourceRef="Gateway_ReminderNeeded" targetRef="End_Reminder" />
    <bpmn:sequenceFlow id="Flow_ReminderEnd" sourceRef="Task_SendReviewReminder" targetRef="End_Reminder" />
    <bpmn:dataStoreReference id="DataStoreReference_Reviews" name="Recenzie v CRM" dataStoreRef="DataStore_Reviews" />
  </bpmn:process>
  <bpmn:process id="Process_Analytics" name="Zápis údajov návštevy a recenzie do analytickej DB" isExecutable="false">
    <bpmn:startEvent id="Start_Analytics" name="Prijaté údaje návštevy">
      <bpmn:outgoing>Flow_AnalyticsWrite</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Analytics" />
    </bpmn:startEvent>
    <bpmn:task id="Task_WriteAnalytics" name="Zápis údajov návštevy do analytickej DB">
      <bpmn:incoming>Flow_AnalyticsWrite</bpmn:incoming>
      <bpmn:outgoing>Flow_AnalyticsEnd</bpmn:outgoing>
      <bpmn:ioSpecification id="IO_ExportVisit">
        <bpmn:dataOutput id="DataOutput_Visit" name="Údaje návštevy" />
        <bpmn:inputSet id="InputSet_ExportVisit" />
        <bpmn:outputSet id="OutputSet_ExportVisit">
          <bpmn:dataOutputRefs>DataOutput_Visit</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="Association_VisitAnalytics">
        <bpmn:sourceRef>DataOutput_Visit</bpmn:sourceRef>
        <bpmn:targetRef>DataStoreReference_Analytics</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:endEvent id="End_Analytics" name="Údaje uložené">
      <bpmn:incoming>Flow_AnalyticsEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Start_ReviewAnalytics" name="Prijatá recenzia">
      <bpmn:outgoing>Flow_WriteReviewAnalytics</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_ReviewAnalytics" />
    </bpmn:startEvent>
    <bpmn:task id="Task_WriteReviewAnalytics" name="Zápis recenzie do analytickej DB">
      <bpmn:incoming>Flow_WriteReviewAnalytics</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewAnalyticsEnd</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Association_ReviewAnalytics">
        <bpmn:targetRef>DataStoreReference_Analytics</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:endEvent id="End_ReviewAnalytics" name="Recenzia uložená">
      <bpmn:incoming>Flow_ReviewAnalyticsEnd</bpmn:incoming>
