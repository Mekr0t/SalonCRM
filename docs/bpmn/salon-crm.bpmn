<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_SalonCrm" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:error id="Error_SlotCollision" name="Kolízia termínu" errorCode="23P01" />
  <bpmn:error id="Error_NoAccess" name="Bez oprávnenia" errorCode="404" />
  <bpmn:error id="Error_InvalidTransition" name="Neplatný prechod stavu" errorCode="409" />
  <bpmn:error id="Error_NoHistory" name="Nedostatok histórie" errorCode="422" />
  <bpmn:message id="Msg_C_RetentionStart" name="Kontakt zo salónu" />
  <bpmn:message id="Msg_S_PhoneStart" name="Telefonát zákazníka" />
  <bpmn:message id="Msg_S_MsgReschedule" name="Žiadosť o zmenu termínu" />
  <bpmn:message id="Msg_S_MsgCancel" name="Žiadosť o zrušenie termínu" />
  <bpmn:message id="Msg_S_MsgArrived" name="Zákazník prišiel" />
  <bpmn:message id="Msg_R_OnlineStart" name="Prijatá online rezervácia" />
  <bpmn:message id="Msg_R_IntrospectStart" name="Požiadavka na overenie session" />
  <bpmn:message id="Msg_R_ExportStart" name="Požiadavka na export dát" />
  <bpmn:message id="Msg_M_Start" name="Požiadavka na prepočet" />
  <bpmn:collaboration id="Collaboration_SalonCrm">
    <bpmn:participant id="Participant_Customer" name="Zákazník" processRef="Process_Customer" />
    <bpmn:participant id="Participant_Salon" name="Kozmetický salón" processRef="Process_Salon" />
    <bpmn:participant id="Participant_ML" name="ML služba (predikcia odchodu)" processRef="Process_ML" />
    <bpmn:messageFlow id="Message_C_Call_S_PhoneStart" name="Telefonát" sourceRef="C_Call" targetRef="S_PhoneStart" />
    <bpmn:messageFlow id="Message_C_Submit_R_OnlineStart" name="Údaje rezervácie" sourceRef="C_Submit" targetRef="R_OnlineStart" />
    <bpmn:messageFlow id="Message_R_ShowConfirm_C_ReceiveResult" name="Potvrdenie rezervácie" sourceRef="R_ShowConfirm" targetRef="C_ReceiveResult" />
    <bpmn:messageFlow id="Message_R_ShowReject_C_ReceiveResult" name="Dôvod zamietnutia" sourceRef="R_ShowReject" targetRef="C_ReceiveResult" />
    <bpmn:messageFlow id="Message_S_TellBooked_C_ReceivePhoneConfirm" name="Dohodnutý termín" sourceRef="S_TellBooked" targetRef="C_ReceivePhoneConfirm" />
    <bpmn:messageFlow id="Message_C_RequestReschedule_S_MsgReschedule" name="Žiadosť o zmenu" sourceRef="C_RequestReschedule" targetRef="S_MsgReschedule" />
    <bpmn:messageFlow id="Message_S_TellNewTime_C_ReceiveNewTime" name="Nový termín" sourceRef="S_TellNewTime" targetRef="C_ReceiveNewTime" />
    <bpmn:messageFlow id="Message_C_RequestCancel_S_MsgCancel" name="Žiadosť o zrušenie" sourceRef="C_RequestCancel" targetRef="S_MsgCancel" />
    <bpmn:messageFlow id="Message_S_ConfirmCancel_C_ReceiveCancelAnswer" name="Potvrdenie zrušenia" sourceRef="S_ConfirmCancel" targetRef="C_ReceiveCancelAnswer" />
    <bpmn:messageFlow id="Message_S_ExplainCancel_C_ReceiveCancelAnswer" name="Termín nemožno zrušiť" sourceRef="S_ExplainCancel" targetRef="C_ReceiveCancelAnswer" />
    <bpmn:messageFlow id="Message_C_Arrive_S_MsgArrived" name="Príchod" sourceRef="C_Arrive" targetRef="S_MsgArrived" />
    <bpmn:messageFlow id="Message_C_Pay_S_ReceivePayment" name="Platba" sourceRef="C_Pay" targetRef="S_ReceivePayment" />
    <bpmn:messageFlow id="Message_A_RunPipeline_M_Start" name="POST /ml/pipeline/run" sourceRef="A_RunPipeline" targetRef="M_Start" />
    <bpmn:messageFlow id="Message_M_AskIntrospect_R_IntrospectStart" name="Introspect session" sourceRef="M_AskIntrospect" targetRef="R_IntrospectStart" />
    <bpmn:messageFlow id="Message_R_IntrospectReply_M_ReceiveIntrospect" name="Rola a platnosť session" sourceRef="R_IntrospectReply" targetRef="M_ReceiveIntrospect" />
    <bpmn:messageFlow id="Message_M_AskExport_R_ExportStart" name="GET /api/internal/ml/export" sourceRef="M_AskExport" targetRef="R_ExportStart" />
    <bpmn:messageFlow id="Message_R_SendExport_M_ReceiveExport" name="Pseudonymizované termíny" sourceRef="R_SendExport" targetRef="M_ReceiveExport" />
    <bpmn:messageFlow id="Message_M_SendSummary_A_ReceiveRun" name="Súhrn behu a metriky" sourceRef="M_SendSummary" targetRef="A_ReceiveRun" />
    <bpmn:messageFlow id="Message_M_SendError_A_ReceiveRun" name="ProblemDetails" sourceRef="M_SendError" targetRef="A_ReceiveRun" />
    <bpmn:messageFlow id="Message_A_R_Contact_C_RetentionStart" name="Telefonát / e-mail / SMS" sourceRef="A_R_Contact" targetRef="C_RetentionStart" />
    <bpmn:messageFlow id="Message_C_AgreeTime_A_R_Book" name="Dohodnutý termín" sourceRef="C_AgreeTime" targetRef="A_R_Book" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Customer" name="Zákazník" isExecutable="false">
    <bpmn:documentation>Zákazník nemá účet. Rezervuje online cez verejný formulár alebo telefonicky.</bpmn:documentation>
    <bpmn:startEvent id="C_Start" name="Potreba ošetrenia">
      <bpmn:outgoing>Flow_C_Start_C_GwChannel</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="C_GwChannel" name="Ako si zákazník rezervuje?">
      <bpmn:incoming>Flow_C_Start_C_GwChannel</bpmn:incoming>
      <bpmn:outgoing>Flow_C_GwChannel_C_SelectService</bpmn:outgoing>
      <bpmn:outgoing>Flow_C_GwChannel_C_Call</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="C_SelectService" name="Výber služby">
      <bpmn:incoming>Flow_C_GwChannel_C_SelectService</bpmn:incoming>
      <bpmn:outgoing>Flow_C_SelectService_C_SelectEmployee</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="C_SelectEmployee" name="Výber pracovníka alebo „ktokoľvek“">
      <bpmn:incoming>Flow_C_SelectService_C_SelectEmployee</bpmn:incoming>
      <bpmn:outgoing>Flow_C_SelectEmployee_C_GwRetry</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="C_GwRetry">
      <bpmn:incoming>Flow_C_SelectEmployee_C_GwRetry</bpmn:incoming>
      <bpmn:incoming>Flow_C_GwCreated_C_GwRetry</bpmn:incoming>
      <bpmn:outgoing>Flow_C_GwRetry_C_SelectSlot</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="C_SelectSlot" name="Výber dátumu a voľného času">
      <bpmn:incoming>Flow_C_GwRetry_C_SelectSlot</bpmn:incoming>
      <bpmn:outgoing>Flow_C_SelectSlot_C_FillContact</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="C_FillContact" name="Vyplnenie kontaktných údajov">
      <bpmn:incoming>Flow_C_SelectSlot_C_FillContact</bpmn:incoming>
      <bpmn:outgoing>Flow_C_FillContact_C_Consent</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="C_Consent" name="Udelenie súhlasu so spracovaním osobných údajov">
      <bpmn:incoming>Flow_C_FillContact_C_Consent</bpmn:incoming>
      <bpmn:outgoing>Flow_C_Consent_C_Submit</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="C_Submit" name="Odoslanie online rezervácie">
      <bpmn:incoming>Flow_C_Consent_C_Submit</bpmn:incoming>
      <bpmn:outgoing>Flow_C_Submit_C_ReceiveResult</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="C_ReceiveResult" name="Prijatie výsledku rezervácie">
      <bpmn:incoming>Flow_C_Submit_C_ReceiveResult</bpmn:incoming>
      <bpmn:outgoing>Flow_C_ReceiveResult_C_GwCreated</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="C_GwCreated" name="Je rezervácia vytvorená?">
      <bpmn:incoming>Flow_C_ReceiveResult_C_GwCreated</bpmn:incoming>
      <bpmn:outgoing>Flow_C_GwCreated_C_GwBooked</bpmn:outgoing>
      <bpmn:outgoing>Flow_C_GwCreated_C_GwRetry</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="C_Call" name="Zavolanie do salónu">
      <bpmn:incoming>Flow_C_GwChannel_C_Call</bpmn:incoming>
      <bpmn:outgoing>Flow_C_Call_C_ReceivePhoneConfirm</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="C_ReceivePhoneConfirm" name="Prijatie potvrdenia termínu">
      <bpmn:incoming>Flow_C_Call_C_ReceivePhoneConfirm</bpmn:incoming>
      <bpmn:outgoing>Flow_C_ReceivePhoneConfirm_C_GwBooked</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="C_GwBooked">
      <bpmn:incoming>Flow_C_GwCreated_C_GwBooked</bpmn:incoming>
      <bpmn:incoming>Flow_C_ReceivePhoneConfirm_C_GwBooked</bpmn:incoming>
      <bpmn:incoming>Flow_C_ReceiveNewTime_C_GwBooked</bpmn:incoming>
      <bpmn:outgoing>Flow_C_GwBooked_C_GwAttend</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="C_GwAttend" name="Môže zákazník prísť v termíne?">
      <bpmn:incoming>Flow_C_GwBooked_C_GwAttend</bpmn:incoming>
      <bpmn:outgoing>Flow_C_GwAttend_C_Arrive</bpmn:outgoing>
      <bpmn:outgoing>Flow_C_GwAttend_C_RequestReschedule</bpmn:outgoing>
      <bpmn:outgoing>Flow_C_GwAttend_C_RequestCancel</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="C_RequestReschedule" name="Žiadosť o zmenu termínu">
      <bpmn:incoming>Flow_C_GwAttend_C_RequestReschedule</bpmn:incoming>
      <bpmn:outgoing>Flow_C_RequestReschedule_C_ReceiveNewTime</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="C_ReceiveNewTime" name="Prijatie nového termínu">
      <bpmn:incoming>Flow_C_RequestReschedule_C_ReceiveNewTime</bpmn:incoming>
      <bpmn:outgoing>Flow_C_ReceiveNewTime_C_GwBooked</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="C_RequestCancel" name="Žiadosť o zrušenie termínu">
      <bpmn:incoming>Flow_C_GwAttend_C_RequestCancel</bpmn:incoming>
      <bpmn:outgoing>Flow_C_RequestCancel_C_ReceiveCancelAnswer</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="C_ReceiveCancelAnswer" name="Prijatie odpovede salónu">
      <bpmn:incoming>Flow_C_RequestCancel_C_ReceiveCancelAnswer</bpmn:incoming>
      <bpmn:outgoing>Flow_C_ReceiveCancelAnswer_C_EndCancel</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="C_EndCancel" name="Žiadosť o zrušenie vybavená">
      <bpmn:incoming>Flow_C_ReceiveCancelAnswer_C_EndCancel</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="C_Arrive" name="Príchod do salónu">
      <bpmn:incoming>Flow_C_GwAttend_C_Arrive</bpmn:incoming>
      <bpmn:outgoing>Flow_C_Arrive_C_Undergo</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:manualTask id="C_Undergo" name="Absolvovanie ošetrenia">
      <bpmn:incoming>Flow_C_Arrive_C_Undergo</bpmn:incoming>
      <bpmn:outgoing>Flow_C_Undergo_C_Pay</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sendTask id="C_Pay" name="Zaplatenie hotovosťou alebo kartou">
      <bpmn:incoming>Flow_C_Undergo_C_Pay</bpmn:incoming>
      <bpmn:outgoing>Flow_C_Pay_C_EndVisit</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="C_EndVisit" name="Ošetrenie absolvované">
      <bpmn:incoming>Flow_C_Pay_C_EndVisit</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="C_RetentionStart" name="Kontakt zo salónu">
      <bpmn:outgoing>Flow_C_RetentionStart_C_Talk</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_C_RetentionStart" messageRef="Msg_C_RetentionStart" />
    </bpmn:startEvent>
    <bpmn:manualTask id="C_Talk" name="Rozhovor o ďalšej návšteve">
      <bpmn:incoming>Flow_C_RetentionStart_C_Talk</bpmn:incoming>
      <bpmn:outgoing>Flow_C_Talk_C_GwInterest</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="C_GwInterest" name="Chce si dohodnúť termín?">
      <bpmn:incoming>Flow_C_Talk_C_GwInterest</bpmn:incoming>
      <bpmn:outgoing>Flow_C_GwInterest_C_EndNoInterest</bpmn:outgoing>
      <bpmn:outgoing>Flow_C_GwInterest_C_AgreeTime</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="C_AgreeTime" name="Dohodnutie nového termínu">
      <bpmn:incoming>Flow_C_GwInterest_C_AgreeTime</bpmn:incoming>
      <bpmn:outgoing>Flow_C_AgreeTime_C_EndNewTime</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="C_EndNewTime" name="Nový termín dohodnutý">
      <bpmn:incoming>Flow_C_AgreeTime_C_EndNewTime</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="C_EndNoInterest" name="Bez záujmu">
      <bpmn:incoming>Flow_C_GwInterest_C_EndNoInterest</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_C_Start_C_GwChannel" sourceRef="C_Start" targetRef="C_GwChannel" />
    <bpmn:sequenceFlow id="Flow_C_GwChannel_C_SelectService" name="Online" sourceRef="C_GwChannel" targetRef="C_SelectService" />
    <bpmn:sequenceFlow id="Flow_C_GwChannel_C_Call" name="Telefonicky" sourceRef="C_GwChannel" targetRef="C_Call" />
    <bpmn:sequenceFlow id="Flow_C_SelectService_C_SelectEmployee" sourceRef="C_SelectService" targetRef="C_SelectEmployee" />
    <bpmn:sequenceFlow id="Flow_C_SelectEmployee_C_GwRetry" sourceRef="C_SelectEmployee" targetRef="C_GwRetry" />
    <bpmn:sequenceFlow id="Flow_C_GwRetry_C_SelectSlot" sourceRef="C_GwRetry" targetRef="C_SelectSlot" />
    <bpmn:sequenceFlow id="Flow_C_SelectSlot_C_FillContact" sourceRef="C_SelectSlot" targetRef="C_FillContact" />
    <bpmn:sequenceFlow id="Flow_C_FillContact_C_Consent" sourceRef="C_FillContact" targetRef="C_Consent" />
    <bpmn:sequenceFlow id="Flow_C_Consent_C_Submit" sourceRef="C_Consent" targetRef="C_Submit" />
    <bpmn:sequenceFlow id="Flow_C_Submit_C_ReceiveResult" sourceRef="C_Submit" targetRef="C_ReceiveResult" />
    <bpmn:sequenceFlow id="Flow_C_ReceiveResult_C_GwCreated" sourceRef="C_ReceiveResult" targetRef="C_GwCreated" />
    <bpmn:sequenceFlow id="Flow_C_GwCreated_C_GwBooked" name="Áno" sourceRef="C_GwCreated" targetRef="C_GwBooked" />
    <bpmn:sequenceFlow id="Flow_C_GwCreated_C_GwRetry" name="Nie – vybrať iný čas" sourceRef="C_GwCreated" targetRef="C_GwRetry" />
    <bpmn:sequenceFlow id="Flow_C_Call_C_ReceivePhoneConfirm" sourceRef="C_Call" targetRef="C_ReceivePhoneConfirm" />
    <bpmn:sequenceFlow id="Flow_C_ReceivePhoneConfirm_C_GwBooked" sourceRef="C_ReceivePhoneConfirm" targetRef="C_GwBooked" />
    <bpmn:sequenceFlow id="Flow_C_GwBooked_C_GwAttend" sourceRef="C_GwBooked" targetRef="C_GwAttend" />
    <bpmn:sequenceFlow id="Flow_C_GwAttend_C_Arrive" name="Áno" sourceRef="C_GwAttend" targetRef="C_Arrive" />
    <bpmn:sequenceFlow id="Flow_C_GwAttend_C_RequestReschedule" name="Nie, chce iný termín" sourceRef="C_GwAttend" targetRef="C_RequestReschedule" />
    <bpmn:sequenceFlow id="Flow_C_GwAttend_C_RequestCancel" name="Nie, chce zrušiť" sourceRef="C_GwAttend" targetRef="C_RequestCancel" />
    <bpmn:sequenceFlow id="Flow_C_RequestReschedule_C_ReceiveNewTime" sourceRef="C_RequestReschedule" targetRef="C_ReceiveNewTime" />
    <bpmn:sequenceFlow id="Flow_C_ReceiveNewTime_C_GwBooked" sourceRef="C_ReceiveNewTime" targetRef="C_GwBooked" />
    <bpmn:sequenceFlow id="Flow_C_RequestCancel_C_ReceiveCancelAnswer" sourceRef="C_RequestCancel" targetRef="C_ReceiveCancelAnswer" />
    <bpmn:sequenceFlow id="Flow_C_ReceiveCancelAnswer_C_EndCancel" sourceRef="C_ReceiveCancelAnswer" targetRef="C_EndCancel" />
    <bpmn:sequenceFlow id="Flow_C_Arrive_C_Undergo" sourceRef="C_Arrive" targetRef="C_Undergo" />
    <bpmn:sequenceFlow id="Flow_C_Undergo_C_Pay" sourceRef="C_Undergo" targetRef="C_Pay" />
    <bpmn:sequenceFlow id="Flow_C_Pay_C_EndVisit" sourceRef="C_Pay" targetRef="C_EndVisit" />
    <bpmn:sequenceFlow id="Flow_C_RetentionStart_C_Talk" sourceRef="C_RetentionStart" targetRef="C_Talk" />
    <bpmn:sequenceFlow id="Flow_C_Talk_C_GwInterest" sourceRef="C_Talk" targetRef="C_GwInterest" />
    <bpmn:sequenceFlow id="Flow_C_GwInterest_C_EndNoInterest" name="Nie" sourceRef="C_GwInterest" targetRef="C_EndNoInterest" />
    <bpmn:sequenceFlow id="Flow_C_GwInterest_C_AgreeTime" name="Áno" sourceRef="C_GwInterest" targetRef="C_AgreeTime" />
    <bpmn:sequenceFlow id="Flow_C_AgreeTime_C_EndNewTime" sourceRef="C_AgreeTime" targetRef="C_EndNewTime" />
  </bpmn:process>
  <bpmn:process id="Process_Salon" name="Kozmetický salón" isExecutable="false">
    <bpmn:documentation>Životný cyklus termínu: rezervácia (online/telefonicky) → čakanie (preplánovanie, zrušenie) → návšteva alebo nepríchod → platba a uzavretie. Raz týždenne admin spúšťa analýzu rizika odchodu a robí retenčné kontakty. Systém neposiela e-maily (mimo rozsahu, SPEC §1), komunikácia so zákazníkom je cez web alebo telefonicky.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_Salon">
      <bpmn:lane id="Lane_Admin" name="Admin">
        <bpmn:flowNodeRef>A_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_OpenDashboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_RunPipeline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_ReceiveRun</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_GwRunOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_ShowRunError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_EndRunError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Compare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_SelectRisky</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_GwAnyRisky</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_EndNoRisky</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Sub_Retention</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_EndRetention</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Staff" name="Pracovník (User)">
        <bpmn:flowNodeRef>S_PhoneStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_AskNeeds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_GwRetry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_FindSlot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_EnterCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_TellBooked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_GwBooked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_GwWait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_TimerStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_MsgReschedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_GwRescheduleRetry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_PickNewTime</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_TellNewTime</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_MsgCancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_OpenCancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_ConfirmCancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_EndCancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_ExplainCancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_EndNotCancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_GwArrival</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_MsgArrived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_TimerNoShow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_MarkNoShow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_OpenDetail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Sub_Treatment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_WriteNote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_GwAmount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_EditAmount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_MergeAmount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_ReceivePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_ShowConflict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_EndConflict</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CRM" name="CRM systém (hlavný backend)">
        <bpmn:flowNodeRef>R_OnlineStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_GwValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_GwSourceMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_GwEmployee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_AssignEmployee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_GwEmployeeMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_CheckSlot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_GwSlotFree</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_GwRejectTaken</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_RejectTaken</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_GwSourceReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_FindCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_SaveBooking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_BCollision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_GwBookedSource</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_ShowConfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_GwRejectMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_ShowReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_EndRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Reschedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_GwRescheduleOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Sub_Cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_BCancelRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_SaveNoShow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_EndNoShow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_VerifyComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_GwCompleteOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_SaveCompleted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_EndCompleted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_IntrospectStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Introspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_IntrospectReply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_IntrospectEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_ExportStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_CheckApiKey</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_BuildExport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_SendExport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_ExportEnd</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="A_Start" name="Každý pondelok o 8:00">
      <bpmn:outgoing>Flow_A_Start_A_OpenDashboard</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_A_Start">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/2026-01-05T08:00:00+01:00/P7D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:userTask id="A_OpenDashboard" name="Otvorenie ML dashboardu">
      <bpmn:incoming>Flow_A_Start_A_OpenDashboard</bpmn:incoming>
      <bpmn:outgoing>Flow_A_OpenDashboard_A_RunPipeline</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="A_RunPipeline" name="Spustenie prepočtu predikcií">
      <bpmn:incoming>Flow_A_OpenDashboard_A_RunPipeline</bpmn:incoming>
      <bpmn:outgoing>Flow_A_RunPipeline_A_ReceiveRun</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="A_ReceiveRun" name="Prijatie výsledku prepočtu">
      <bpmn:incoming>Flow_A_RunPipeline_A_ReceiveRun</bpmn:incoming>
      <bpmn:outgoing>Flow_A_ReceiveRun_A_GwRunOk</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="A_GwRunOk" name="Prepočet úspešný?">
      <bpmn:incoming>Flow_A_ReceiveRun_A_GwRunOk</bpmn:incoming>
      <bpmn:outgoing>Flow_A_GwRunOk_A_Compare</bpmn:outgoing>
      <bpmn:outgoing>Flow_A_GwRunOk_A_ShowRunError</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="A_ShowRunError" name="Zobrazenie chyby prepočtu">
      <bpmn:incoming>Flow_A_GwRunOk_A_ShowRunError</bpmn:incoming>
      <bpmn:outgoing>Flow_A_ShowRunError_A_EndRunError</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="A_EndRunError" name="Analýza neprebehla">
      <bpmn:incoming>Flow_A_ShowRunError_A_EndRunError</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="A_Compare" name="Porovnanie modelu s baseline">
      <bpmn:incoming>Flow_A_GwRunOk_A_Compare</bpmn:incoming>
      <bpmn:outgoing>Flow_A_Compare_A_SelectRisky</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="A_SelectRisky" name="Výber zákazníkov s vysokým rizikom">
      <bpmn:incoming>Flow_A_Compare_A_SelectRisky</bpmn:incoming>
      <bpmn:outgoing>Flow_A_SelectRisky_A_GwAnyRisky</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="A_GwAnyRisky" name="Sú zákazníci s vysokým rizikom?">
      <bpmn:incoming>Flow_A_SelectRisky_A_GwAnyRisky</bpmn:incoming>
      <bpmn:outgoing>Flow_A_GwAnyRisky_A_Sub_Retention</bpmn:outgoing>
      <bpmn:outgoing>Flow_A_GwAnyRisky_A_EndNoRisky</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="A_EndNoRisky" name="Bez retenčných akcií">
      <bpmn:incoming>Flow_A_GwAnyRisky_A_EndNoRisky</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="A_Sub_Retention" name="Retenčný kontakt so zákazníkom">
      <bpmn:incoming>Flow_A_GwAnyRisky_A_Sub_Retention</bpmn:incoming>
      <bpmn:outgoing>Flow_A_Sub_Retention_A_EndRetention</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:startEvent id="A_R_Start" name="Rizikový zákazník">
        <bpmn:outgoing>Flow_A_R_Start_A_R_Load</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="A_R_Load" name="Načítanie karty zákazníka a zdôvodnenia rizika">
        <bpmn:incoming>Flow_A_R_Start_A_R_Load</bpmn:incoming>
        <bpmn:outgoing>Flow_A_R_Load_A_R_Contact</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sendTask id="A_R_Contact" name="Kontaktovanie zákazníka">
        <bpmn:incoming>Flow_A_R_Load_A_R_Contact</bpmn:incoming>
        <bpmn:outgoing>Flow_A_R_Contact_A_R_Gw</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:exclusiveGateway id="A_R_Gw" name="Má zákazník záujem o termín?">
        <bpmn:incoming>Flow_A_R_Contact_A_R_Gw</bpmn:incoming>
        <bpmn:outgoing>Flow_A_R_Gw_A_R_Merge</bpmn:outgoing>
        <bpmn:outgoing>Flow_A_R_Gw_A_R_Book</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="A_R_Book" name="Vytvorenie telefonickej rezervácie">
        <bpmn:incoming>Flow_A_R_Gw_A_R_Book</bpmn:incoming>
        <bpmn:outgoing>Flow_A_R_Book_A_R_Merge</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="A_R_Merge">
        <bpmn:incoming>Flow_A_R_Gw_A_R_Merge</bpmn:incoming>
        <bpmn:incoming>Flow_A_R_Book_A_R_Merge</bpmn:incoming>
        <bpmn:outgoing>Flow_A_R_Merge_A_R_Record</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="A_R_Record" name="Zaznamenanie retenčnej akcie">
        <bpmn:incoming>Flow_A_R_Merge_A_R_Record</bpmn:incoming>
        <bpmn:outgoing>Flow_A_R_Record_A_R_End</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="A_R_End" name="Kontakt zaznamenaný">
        <bpmn:incoming>Flow_A_R_Record_A_R_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_A_R_Start_A_R_Load" sourceRef="A_R_Start" targetRef="A_R_Load" />
      <bpmn:sequenceFlow id="Flow_A_R_Load_A_R_Contact" sourceRef="A_R_Load" targetRef="A_R_Contact" />
      <bpmn:sequenceFlow id="Flow_A_R_Contact_A_R_Gw" sourceRef="A_R_Contact" targetRef="A_R_Gw" />
      <bpmn:sequenceFlow id="Flow_A_R_Gw_A_R_Merge" name="Nie" sourceRef="A_R_Gw" targetRef="A_R_Merge" />
      <bpmn:sequenceFlow id="Flow_A_R_Gw_A_R_Book" name="Áno" sourceRef="A_R_Gw" targetRef="A_R_Book" />
      <bpmn:sequenceFlow id="Flow_A_R_Book_A_R_Merge" sourceRef="A_R_Book" targetRef="A_R_Merge" />
      <bpmn:sequenceFlow id="Flow_A_R_Merge_A_R_Record" sourceRef="A_R_Merge" targetRef="A_R_Record" />
      <bpmn:sequenceFlow id="Flow_A_R_Record_A_R_End" sourceRef="A_R_Record" targetRef="A_R_End" />
    </bpmn:subProcess>
    <bpmn:endEvent id="A_EndRetention" name="Retenčné akcie zaznamenané">
      <bpmn:incoming>Flow_A_Sub_Retention_A_EndRetention</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="S_PhoneStart" name="Telefonát zákazníka">
      <bpmn:outgoing>Flow_S_PhoneStart_S_AskNeeds</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_S_PhoneStart" messageRef="Msg_S_PhoneStart" />
    </bpmn:startEvent>
    <bpmn:userTask id="S_AskNeeds" name="Zistenie želanej služby a pracovníka">
      <bpmn:incoming>Flow_S_PhoneStart_S_AskNeeds</bpmn:incoming>
      <bpmn:outgoing>Flow_S_AskNeeds_S_GwRetry</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="S_GwRetry">
      <bpmn:incoming>Flow_S_AskNeeds_S_GwRetry</bpmn:incoming>
      <bpmn:incoming>Flow_R_GwSourceReject_S_GwRetry</bpmn:incoming>
      <bpmn:outgoing>Flow_S_GwRetry_S_FindSlot</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="S_FindSlot" name="Vyhľadanie voľného času v kalendári">
      <bpmn:incoming>Flow_S_GwRetry_S_FindSlot</bpmn:incoming>
      <bpmn:outgoing>Flow_S_FindSlot_S_EnterCustomer</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="S_EnterCustomer" name="Zadanie údajov zákazníka a potvrdenie súhlasu">
      <bpmn:incoming>Flow_S_FindSlot_S_EnterCustomer</bpmn:incoming>
      <bpmn:outgoing>Flow_S_EnterCustomer_R_GwSourceMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="S_TellBooked" name="Oznámenie termínu zákazníkovi">
      <bpmn:incoming>Flow_R_GwBookedSource_S_TellBooked</bpmn:incoming>
      <bpmn:outgoing>Flow_S_TellBooked_S_GwBooked</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="S_GwBooked">
      <bpmn:incoming>Flow_S_TellBooked_S_GwBooked</bpmn:incoming>
      <bpmn:incoming>Flow_S_TellNewTime_S_GwBooked</bpmn:incoming>
      <bpmn:incoming>Flow_R_ShowConfirm_S_GwBooked</bpmn:incoming>
      <bpmn:outgoing>Flow_S_GwBooked_S_GwWait</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="S_GwWait" name="Čo nastane skôr?">
      <bpmn:incoming>Flow_S_GwBooked_S_GwWait</bpmn:incoming>
      <bpmn:outgoing>Flow_S_GwWait_S_TimerStart</bpmn:outgoing>
      <bpmn:outgoing>Flow_S_GwWait_S_MsgReschedule</bpmn:outgoing>
      <bpmn:outgoing>Flow_S_GwWait_S_MsgCancel</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="S_TimerStart" name="Nastal čas termínu">
      <bpmn:incoming>Flow_S_GwWait_S_TimerStart</bpmn:incoming>
      <bpmn:outgoing>Flow_S_TimerStart_S_GwArrival</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_S_TimerStart">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${appointment.startsAt}</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="S_MsgReschedule" name="Žiadosť o zmenu termínu">
      <bpmn:incoming>Flow_S_GwWait_S_MsgReschedule</bpmn:incoming>
      <bpmn:outgoing>Flow_S_MsgReschedule_S_GwRescheduleRetry</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_S_MsgReschedule" messageRef="Msg_S_MsgReschedule" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="S_GwRescheduleRetry">
      <bpmn:incoming>Flow_S_MsgReschedule_S_GwRescheduleRetry</bpmn:incoming>
      <bpmn:incoming>Flow_R_GwRescheduleOk_S_GwRescheduleRetry</bpmn:incoming>
      <bpmn:outgoing>Flow_S_GwRescheduleRetry_S_PickNewTime</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="S_PickNewTime" name="Výber nového času v kalendári">
      <bpmn:incoming>Flow_S_GwRescheduleRetry_S_PickNewTime</bpmn:incoming>
      <bpmn:outgoing>Flow_S_PickNewTime_R_Reschedule</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="S_TellNewTime" name="Oznámenie nového termínu zákazníkovi">
      <bpmn:incoming>Flow_R_GwRescheduleOk_S_TellNewTime</bpmn:incoming>
      <bpmn:outgoing>Flow_S_TellNewTime_S_GwBooked</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="S_MsgCancel" name="Žiadosť o zrušenie termínu">
      <bpmn:incoming>Flow_S_GwWait_S_MsgCancel</bpmn:incoming>
      <bpmn:outgoing>Flow_S_MsgCancel_S_OpenCancel</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_S_MsgCancel" messageRef="Msg_S_MsgCancel" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="S_OpenCancel" name="Vyhľadanie termínu a voľba Zrušiť">
      <bpmn:incoming>Flow_S_MsgCancel_S_OpenCancel</bpmn:incoming>
      <bpmn:outgoing>Flow_S_OpenCancel_R_Sub_Cancel</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="S_ConfirmCancel" name="Potvrdenie zrušenia zákazníkovi">
      <bpmn:incoming>Flow_R_Sub_Cancel_S_ConfirmCancel</bpmn:incoming>
      <bpmn:outgoing>Flow_S_ConfirmCancel_S_EndCancelled</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="S_EndCancelled" name="Termín zrušený">
      <bpmn:incoming>Flow_S_ConfirmCancel_S_EndCancelled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="S_ExplainCancel" name="Vysvetlenie, prečo termín nemožno zrušiť">
      <bpmn:incoming>Flow_R_BCancelRejected_S_ExplainCancel</bpmn:incoming>
      <bpmn:outgoing>Flow_S_ExplainCancel_S_EndNotCancelled</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="S_EndNotCancelled" name="Termín bez zmeny">
      <bpmn:incoming>Flow_S_ExplainCancel_S_EndNotCancelled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:eventBasedGateway id="S_GwArrival" name="Prišiel zákazník?">
      <bpmn:incoming>Flow_S_TimerStart_S_GwArrival</bpmn:incoming>
      <bpmn:outgoing>Flow_S_GwArrival_S_MsgArrived</bpmn:outgoing>
      <bpmn:outgoing>Flow_S_GwArrival_S_TimerNoShow</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="S_MsgArrived" name="Zákazník prišiel">
      <bpmn:incoming>Flow_S_GwArrival_S_MsgArrived</bpmn:incoming>
      <bpmn:outgoing>Flow_S_MsgArrived_S_OpenDetail</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_S_MsgArrived" messageRef="Msg_S_MsgArrived" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="S_TimerNoShow" name="15 minút po začiatku bez príchodu">
      <bpmn:incoming>Flow_S_GwArrival_S_TimerNoShow</bpmn:incoming>
      <bpmn:outgoing>Flow_S_TimerNoShow_S_MarkNoShow</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_S_TimerNoShow">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT15M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="S_MarkNoShow" name="Označenie termínu ako Neprišiel">
      <bpmn:incoming>Flow_S_TimerNoShow_S_MarkNoShow</bpmn:incoming>
      <bpmn:outgoing>Flow_S_MarkNoShow_R_SaveNoShow</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="S_OpenDetail" name="Otvorenie detailu termínu a karty zákazníka">
      <bpmn:incoming>Flow_S_MsgArrived_S_OpenDetail</bpmn:incoming>
      <bpmn:outgoing>Flow_S_OpenDetail_S_Sub_Treatment</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="S_Sub_Treatment" name="Vykonanie ošetrenia">
      <bpmn:incoming>Flow_S_OpenDetail_S_Sub_Treatment</bpmn:incoming>
      <bpmn:outgoing>Flow_S_Sub_Treatment_S_WriteNote</bpmn:outgoing>
      <bpmn:startEvent id="S_T_Start" name="Zákazník usadený">
        <bpmn:outgoing>Flow_S_T_Start_S_T_Consult</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:manualTask id="S_T_Consult" name="Konzultácia želaní zákazníka">
        <bpmn:incoming>Flow_S_T_Start_S_T_Consult</bpmn:incoming>
        <bpmn:outgoing>Flow_S_T_Consult_S_T_Notes</bpmn:outgoing>
      </bpmn:manualTask>
      <bpmn:userTask id="S_T_Notes" name="Kontrola poznámok v karte zákazníka (alergie, typ pleti)">
        <bpmn:incoming>Flow_S_T_Consult_S_T_Notes</bpmn:incoming>
        <bpmn:outgoing>Flow_S_T_Notes_S_T_Contra</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:manualTask id="S_T_Contra" name="Kontrola kontraindikácií">
        <bpmn:incoming>Flow_S_T_Notes_S_T_Contra</bpmn:incoming>
        <bpmn:outgoing>Flow_S_T_Contra_S_T_GwContra</bpmn:outgoing>
      </bpmn:manualTask>
      <bpmn:exclusiveGateway id="S_T_GwContra" name="Zistené kontraindikácie?">
        <bpmn:incoming>Flow_S_T_Contra_S_T_GwContra</bpmn:incoming>
        <bpmn:outgoing>Flow_S_T_GwContra_S_T_MergeContra</bpmn:outgoing>
        <bpmn:outgoing>Flow_S_T_GwContra_S_T_Adjust</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:manualTask id="S_T_Adjust" name="Úprava postupu ošetrenia">
        <bpmn:incoming>Flow_S_T_GwContra_S_T_Adjust</bpmn:incoming>
        <bpmn:outgoing>Flow_S_T_Adjust_S_T_MergeContra</bpmn:outgoing>
      </bpmn:manualTask>
      <bpmn:exclusiveGateway id="S_T_MergeContra">
        <bpmn:incoming>Flow_S_T_GwContra_S_T_MergeContra</bpmn:incoming>
        <bpmn:incoming>Flow_S_T_Adjust_S_T_MergeContra</bpmn:incoming>
        <bpmn:outgoing>Flow_S_T_MergeContra_S_T_Split</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:parallelGateway id="S_T_Split">
        <bpmn:incoming>Flow_S_T_MergeContra_S_T_Split</bpmn:incoming>
        <bpmn:outgoing>Flow_S_T_Split_S_T_Prepare</bpmn:outgoing>
        <bpmn:outgoing>Flow_S_T_Split_S_T_Diagnose</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:manualTask id="S_T_Prepare" name="Príprava pracoviska a pomôcok">
        <bpmn:incoming>Flow_S_T_Split_S_T_Prepare</bpmn:incoming>
        <bpmn:outgoing>Flow_S_T_Prepare_S_T_Join</bpmn:outgoing>
      </bpmn:manualTask>
      <bpmn:manualTask id="S_T_Diagnose" name="Odlíčenie a diagnostika pleti">
        <bpmn:incoming>Flow_S_T_Split_S_T_Diagnose</bpmn:incoming>
        <bpmn:outgoing>Flow_S_T_Diagnose_S_T_Join</bpmn:outgoing>
      </bpmn:manualTask>
      <bpmn:parallelGateway id="S_T_Join">
        <bpmn:incoming>Flow_S_T_Prepare_S_T_Join</bpmn:incoming>
        <bpmn:incoming>Flow_S_T_Diagnose_S_T_Join</bpmn:incoming>
