  </bpmn:process>
  <bpmn:process id="Process_ML" name="ML služba (predikcia odchodu)" isExecutable="false">
    <bpmn:documentation>Samostatná služba (FastAPI, databáza salon_ml). S hlavným backendom komunikuje iba cez HTTP: overenie session a stiahnutie pseudonymizovaného exportu.</bpmn:documentation>
    <bpmn:startEvent id="M_Start" name="Požiadavka na prepočet">
      <bpmn:outgoing>Flow_M_Start_M_AskIntrospect</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_M_Start" messageRef="Msg_M_Start" />
    </bpmn:startEvent>
    <bpmn:sendTask id="M_AskIntrospect" name="Overenie session cez hlavný backend">
      <bpmn:incoming>Flow_M_Start_M_AskIntrospect</bpmn:incoming>
      <bpmn:outgoing>Flow_M_AskIntrospect_M_ReceiveIntrospect</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="M_ReceiveIntrospect" name="Prijatie výsledku overenia">
      <bpmn:incoming>Flow_M_AskIntrospect_M_ReceiveIntrospect</bpmn:incoming>
      <bpmn:outgoing>Flow_M_ReceiveIntrospect_M_GwAuth</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="M_GwAuth" name="Platná session s rolou Admin?">
      <bpmn:incoming>Flow_M_ReceiveIntrospect_M_GwAuth</bpmn:incoming>
      <bpmn:outgoing>Flow_M_GwAuth_M_Lock</bpmn:outgoing>
      <bpmn:outgoing>Flow_M_GwAuth_M_ErrMerge1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="M_Lock" name="Získanie zámku behu">
      <bpmn:incoming>Flow_M_GwAuth_M_Lock</bpmn:incoming>
      <bpmn:outgoing>Flow_M_Lock_M_GwRunning</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="M_GwRunning" name="Prebieha už iný beh?">
      <bpmn:incoming>Flow_M_Lock_M_GwRunning</bpmn:incoming>
      <bpmn:outgoing>Flow_M_GwRunning_M_AskExport</bpmn:outgoing>
      <bpmn:outgoing>Flow_M_GwRunning_M_ErrMerge1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="M_ErrMerge1">
      <bpmn:incoming>Flow_M_GwAuth_M_ErrMerge1</bpmn:incoming>
      <bpmn:incoming>Flow_M_GwRunning_M_ErrMerge1</bpmn:incoming>
      <bpmn:outgoing>Flow_M_ErrMerge1_M_ErrMerge2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="M_AskExport" name="Vyžiadanie exportu z hlavného backendu">
      <bpmn:incoming>Flow_M_GwRunning_M_AskExport</bpmn:incoming>
      <bpmn:outgoing>Flow_M_AskExport_M_ReceiveExport</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="M_ReceiveExport" name="Prijatie exportu">
      <bpmn:incoming>Flow_M_AskExport_M_ReceiveExport</bpmn:incoming>
      <bpmn:outgoing>Flow_M_ReceiveExport_M_SaveRaw</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="M_SaveRaw" name="Uloženie dát do raw tabuliek (sync)">
      <bpmn:incoming>Flow_M_ReceiveExport_M_SaveRaw</bpmn:incoming>
      <bpmn:outgoing>Flow_M_SaveRaw_M_Sub_Train</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_M_SaveRaw">
        <bpmn:targetRef>M_StoreMl</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="M_StoreMl" name="salon_ml" />
    <bpmn:subProcess id="M_Sub_Train" name="Tréning modelu a predikcia rizika">
      <bpmn:incoming>Flow_M_SaveRaw_M_Sub_Train</bpmn:incoming>
      <bpmn:outgoing>Flow_M_Sub_Train_M_SendSummary</bpmn:outgoing>
      <bpmn:startEvent id="M_T_Start" name="Dáta synchronizované">
        <bpmn:outgoing>Flow_M_T_Start_M_T_Snapshots</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="M_T_Snapshots" name="Zostavenie snapshotov k 8 dátumom">
        <bpmn:incoming>Flow_M_T_Start_M_T_Snapshots</bpmn:incoming>
        <bpmn:outgoing>Flow_M_T_Snapshots_M_T_Features</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="M_T_Features" name="Výpočet príznakov bez úniku budúcich dát">
        <bpmn:incoming>Flow_M_T_Snapshots_M_T_Features</bpmn:incoming>
        <bpmn:outgoing>Flow_M_T_Features_M_T_Labels</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="M_T_Labels" name="Výpočet labelov (odchod do 90 dní)">
        <bpmn:incoming>Flow_M_T_Features_M_T_Labels</bpmn:incoming>
        <bpmn:outgoing>Flow_M_T_Labels_M_T_GwEnough</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="M_T_GwEnough" name="Dostatok histórie na tréning?">
        <bpmn:incoming>Flow_M_T_Labels_M_T_GwEnough</bpmn:incoming>
        <bpmn:outgoing>Flow_M_T_GwEnough_M_T_Split</bpmn:outgoing>
        <bpmn:outgoing>Flow_M_T_GwEnough_M_T_EndNoData</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="M_T_EndNoData" name="Nedostatok histórie (422)">
        <bpmn:incoming>Flow_M_T_GwEnough_M_T_EndNoData</bpmn:incoming>
        <bpmn:errorEventDefinition id="Def_M_T_EndNoData" errorRef="Error_NoHistory" />
      </bpmn:endEvent>
      <bpmn:parallelGateway id="M_T_Split">
        <bpmn:incoming>Flow_M_T_GwEnough_M_T_Split</bpmn:incoming>
        <bpmn:outgoing>Flow_M_T_Split_M_T_LR</bpmn:outgoing>
        <bpmn:outgoing>Flow_M_T_Split_M_T_RF</bpmn:outgoing>
        <bpmn:outgoing>Flow_M_T_Split_M_T_HGB</bpmn:outgoing>
        <bpmn:outgoing>Flow_M_T_Split_M_T_Baseline</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:serviceTask id="M_T_LR" name="Tréning LogisticRegression">
        <bpmn:incoming>Flow_M_T_Split_M_T_LR</bpmn:incoming>
        <bpmn:outgoing>Flow_M_T_LR_M_T_Join</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="M_T_RF" name="Tréning RandomForest">
        <bpmn:incoming>Flow_M_T_Split_M_T_RF</bpmn:incoming>
        <bpmn:outgoing>Flow_M_T_RF_M_T_Join</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="M_T_HGB" name="Tréning HistGradientBoosting">
        <bpmn:incoming>Flow_M_T_Split_M_T_HGB</bpmn:incoming>
        <bpmn:outgoing>Flow_M_T_HGB_M_T_Join</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:businessRuleTask id="M_T_Baseline" name="Vyhodnotenie baseline pravidla">
        <bpmn:incoming>Flow_M_T_Split_M_T_Baseline</bpmn:incoming>
        <bpmn:outgoing>Flow_M_T_Baseline_M_T_Join</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:parallelGateway id="M_T_Join">
        <bpmn:incoming>Flow_M_T_LR_M_T_Join</bpmn:incoming>
        <bpmn:incoming>Flow_M_T_RF_M_T_Join</bpmn:incoming>
        <bpmn:incoming>Flow_M_T_HGB_M_T_Join</bpmn:incoming>
        <bpmn:incoming>Flow_M_T_Baseline_M_T_Join</bpmn:incoming>
        <bpmn:outgoing>Flow_M_T_Join_M_T_Select</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:businessRuleTask id="M_T_Select" name="Výber víťaza podľa ROC-AUC">
        <bpmn:incoming>Flow_M_T_Join_M_T_Select</bpmn:incoming>
        <bpmn:outgoing>Flow_M_T_Select_M_T_Importance</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:serviceTask id="M_T_Importance" name="Výpočet dôležitosti príznakov">
        <bpmn:incoming>Flow_M_T_Select_M_T_Importance</bpmn:incoming>
        <bpmn:outgoing>Flow_M_T_Importance_M_T_Retrain</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="M_T_Retrain" name="Pretrénovanie víťaza na všetkých snapshotoch">
        <bpmn:incoming>Flow_M_T_Importance_M_T_Retrain</bpmn:incoming>
        <bpmn:outgoing>Flow_M_T_Retrain_M_T_SaveModel</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="M_T_SaveModel" name="Uloženie aktívnej verzie modelu">
        <bpmn:incoming>Flow_M_T_Retrain_M_T_SaveModel</bpmn:incoming>
        <bpmn:outgoing>Flow_M_T_SaveModel_M_T_Predict</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="M_T_Predict" name="Predikcia rizika pre zákazníkov">
        <bpmn:incoming>Flow_M_T_SaveModel_M_T_Predict</bpmn:incoming>
        <bpmn:outgoing>Flow_M_T_Predict_M_T_Explain</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="M_T_Explain" name="Generovanie zdôvodnení">
        <bpmn:incoming>Flow_M_T_Predict_M_T_Explain</bpmn:incoming>
        <bpmn:outgoing>Flow_M_T_Explain_M_T_End</bpmn:outgoing>
