      <bpmn:sequenceFlow id="Flow_S_T_Split_S_T_Diagnose" sourceRef="S_T_Split" targetRef="S_T_Diagnose" />
      <bpmn:sequenceFlow id="Flow_S_T_Prepare_S_T_Join" sourceRef="S_T_Prepare" targetRef="S_T_Join" />
