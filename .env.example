# Copy to .env:  cp .env.example .env
# Demo values only — change secrets for anything beyond localhost.

# Databases
POSTGRES_MAIN_PASSWORD=salon_main_dev
POSTGRES_ML_PASSWORD=salon_ml_dev

# Shared secret for main <-> ml internal API (long random string)
INTERNAL_API_KEY=change-me-to-a-long-random-string

# Main backend (app)
SEED_DEMO_DATA=true
SEED_ADMIN_PASSWORD=Admin123!
SEED_USER_PASSWORD=User123!
COOKIE_SECURE=false

# Frontend build (baked into the app image)
VITE_ML_API_URL=http://localhost:8000

# ML backend (ml)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
MAIN_API_URL=http://app:8080
SESSION_COOKIE_NAME=salon_sid
MODEL_DIR=/app/models
